{
  "name": "pi-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --mac dir",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "node node_modules/electron/install.js",
    "prepare": "lefthook install",
    "icons": "scripts/build-icons.sh"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@lexical/history": "0.50.0",
    "@lexical/react": "0.50.0",
    "@lexical/utils": "0.50.0",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.14.6",
    "katex": "^0.18.7",
    "lefthook": "^2.1.14",
    "lexical": "0.50.0",
    "lucide-react": "^1.46.0",
    "marked": "^17.0.6",
    "mermaid": "^12.0.0",
    "monaco-editor": "^0.56.0",
    "motion": "12",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.0",
    "shiki": "^3.19.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "zustand": "^5.0.15"
  },
  "packageManager": "bun@1.3.11",
  "build": {
    "appId": "dev.pi-dot.app",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "resources/**",
      "!**/node_modules/**/*.{map,d.ts,d.mts,d.cts}"
    ],
    "electronLanguages": [
      "en",
      "zh_CN"
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false
    }
  },
  "productName": "Pi Dot",
  "trustedDependencies": [
    "electron",
    "esbuild",
    "lefthook"
  ]
}
